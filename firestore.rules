rules_version = '2';

// No player login: the app writes with the public web key. Episode and player
// records are append-only. The settings doc is the one exception: it stores a
// cutoff so the dashboard can hide older scores without deleting them.
service cloud.firestore {
  match /databases/{database}/documents {

    match /players/{playerId} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string
                            && request.resource.data.name.size() <= 32;
      allow delete: if false;
    }

    match /episodes/{episodeId} {
      allow read: if true;
      allow create: if request.resource.data.playerName is string
                    && request.resource.data.playerName.size() <= 32
                    && request.resource.data.difficulty in ['easy', 'medium', 'hard']
                    && request.resource.data.outcome in ['goal', 'trap']
                    && request.resource.data.totalReward is number
                    && request.resource.data.moves is int;
      allow update, delete: if false;
    }

    // One-doc cutoff so the dashboard can start a fresh scoring window
    // without deleting anything. World-writable like the rest of this app.
    match /settings/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
